{
  "name": "agentic-pr-review",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc",
    "lint": "eslint src",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.js",
    "check": "npm run lint && npm run build && npm test && npm run smoke",
    "review": "node dist/local.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
